{
  "name": "pybind11-navigate",
  "displayName": "pybind11 Navigate",
  "description": "Navigate from Python symbols to pybind11 bindings and C++ implementations.",
  "publisher": "XuetaoLi",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "repository": "https://github.com/Alanxtl/pybind11-navigate",
  "activationEvents": [
    "onLanguage:python"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node test/navigation.test.js && node test/extension-v2.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "pybind11Navigation.goToImplementation",
        "title": "Go to C++ Implementation",
        "category": "pybind11 Navigate"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pybind11Navigation.goToImplementation",
          "when": "editorLangId == python",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "pybind11 Navigate",
      "properties": {
        "pybind11Navigation.include": {
          "type": "string",
          "default": "**/*.{cc,cpp,cxx,h,hh,hpp,hxx,cu,cuh}",
          "scope": "resource",
          "description": "Glob for C++ binding sources, relative to each workspace folder."
        },
        "pybind11Navigation.exclude": {
          "type": "string",
          "default": "{**/.git/**,**/.venv/**,**/build*/**,**/node_modules/**}",
          "scope": "resource",
          "description": "Glob for paths to skip while indexing."
        },
        "pybind11Navigation.moduleMap": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "scope": "resource",
          "description": "Map full Python import paths to names used in PYBIND11_MODULE."
        },
        "pybind11Navigation.moduleSources": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "description": "Associate a Python import path with a native module and a source directory, including directories outside the workspace. Relative paths are resolved against the Python workspace folder.",
          "additionalProperties": {
            "type": "object",
            "required": ["module", "path"],
            "additionalProperties": false,
            "properties": {
              "module": { "type": "string", "description": "Name used in PYBIND11_MODULE." },
              "path": { "type": "string", "description": "C++ source directory on the extension host." }
            }
          }
        },
        "pybind11Navigation.useClangd": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Use the installed clangd extension's AST when available and fall back to source indexing otherwise."
        },
        "pybind11Navigation.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Python 3 executable for parsing source. Leave empty to use python3 (python on Windows)."
        }
      }
    }
  },
  "dependencies": {
    "picomatch": "4.0.7"
  }
}
